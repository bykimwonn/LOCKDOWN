<?xml version="1.0" encoding="utf-8"?>
<!--
  Device admin / device-owner policy for BT LOCKDOWN.

  As a *device admin* (normal install) BT LOCKDOWN only uses the admin role as
  an uninstall tripwire — it never locks, wipes, resets passwords, or disables
  cameras.

  When the app is provisioned as *device owner* (via `adb shell dpm
  set-device-owner com.btsoftware.lockdown/.LockdownAdminReceiver` or an EMM),
  the "force-lock" + "screen-pinning" / lock-task policies become active. That
  is what lets the app pin the whole device in kiosk mode during a session:
  back/home/recents are disabled, the app cannot be force-stopped or swiped
  from recents, and the only way out is the session end. This is the meaningful
  defence against "force-stop the app to escape".
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <screen-pinning />
        <!-- Only meaningful when device owner. No wipe / reset / password
             restrictions are claimed, so the student's data is never at risk. -->
    </uses-policies>
</device-admin>
